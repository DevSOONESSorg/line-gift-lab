# =====================================================
# TFLint（Terraform のコードの「書き方の注意」を見る道具）の設定
#   terraform validate は「文法として正しいか」、TFLint は「よくある書き方のミスや、
#   使っていない変数・型の付け忘れなど、良くない書き方」を見ます。
# =====================================================
plugin "terraform" {
  enabled = true
  preset  = "recommended" # Terraform 公式の推奨ルール一式
}
