<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= appName %> 教材</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="area-<%= area %> page-<%= mockPage %>">
  <nav class="global">
    <a class="brand" href="/"><%= appName %> <small>教材</small></a>
    <a class="g g-admin <%= area === 'admin' ? 'on' : '' %>" href="/admin">管理画面<small>自社</small></a>
    <a class="g g-phone <%= mockPage === 'phone' ? 'on' : '' %>" href="/mock/phone">スマホ<small>疑似</small></a>
    <a class="g g-manager <%= mockPage === 'manager' ? 'on' : '' %>" href="/mock/manager">Manager<small>疑似LINE</small></a>
    <a class="g g-dev <%= mockPage === 'developers' ? 'on' : '' %>" href="/mock/developers">Dev Console<small>疑似LINE</small></a>
    <a class="g g-inside <%= area === 'inside' ? 'on' : '' %>" href="/inside">裏側ビュー</a>
  </nav>
  <% if (msg) { %><div class="flash"><%= msg %></div><% } %>
