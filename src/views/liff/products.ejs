<%- include('_head') %>
<p><a href="/liff/platform/manage?mock_uid=<%= uid %>">← 店舗管理</a></p>
<h1><%= store.name %> の商品登録</h1>
<p class="small">お客さんが選べる商品です。1つ以上ないと、贈り物を買えません。</p>
<% menus.forEach(function (m) { %>
  <div class="store-card row-between">
    <span><strong><%= m.name %></strong> <%= yen(m.price) %></span>
    <form method="post" action="/liff/platform/manage/<%= store.id %>/products/<%= m.id %>/delete">
      <input type="hidden" name="mock_uid" value="<%= uid %>"><button class="btn small secondary">削除</button></form>
  </div>
<% }) %>
<% if (!menus.length) { %><p class="err">まだ商品がありません。</p><% } %>
<h2>商品を追加</h2>
<form method="post" action="/liff/platform/manage/<%= store.id %>/products">
  <input type="hidden" name="mock_uid" value="<%= uid %>">
  <label>商品名 <input name="name" placeholder="例：乾杯ドリンク"></label>
  <label>価格（円） <input name="price" type="number" min="1"></label>
  <button class="btn wide">追加する</button>
</form>
<%- include('_foot') %>
