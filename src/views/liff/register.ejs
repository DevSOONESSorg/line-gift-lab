<%- include('_head') %>
<h1>出店登録</h1>
<p class="small">おくりギフトに、あなたのお店を登録します。登録したLINEアカウントが、そのお店の「オーナー」になります（贈り物の受け取りや商品登録ができる人）。</p>
<% if (error) { %><p class="err"><%= error %></p><% } %>
<form method="post" action="/liff/platform/register">
  <input type="hidden" name="mock_uid" value="<%= uid %>">

  <h2>1. ユーザー登録（オーナー）</h2>
  <label>お名前 <input name="owner_name" value="<%= form.owner_name || '' %>" placeholder="例：山田 太郎"></label>
  <label>電話番号 <input name="owner_phone" value="<%= form.owner_phone || '' %>" placeholder="例：098-000-0000" inputmode="tel"></label>

  <h2>2. お店の情報</h2>
  <label>店名 <input name="name" value="<%= form.name || '' %>" placeholder="例：クラブ アズール"></label>

  <h2>3. 口座登録（売上の振込先）</h2>
  <p class="notice">体験用です。<strong>本物の口座番号は入れないでください</strong>（例：1234567）。</p>
  <label>銀行名 <input name="bank_name" value="<%= form.bank_name || '' %>" placeholder="例：さくら銀行"></label>
  <label>支店名 <input name="bank_branch" value="<%= form.bank_branch || '' %>" placeholder="例：那覇支店"></label>
  <div class="row">
    <label>種別
      <select name="bank_type"><option <%= form.bank_type === '当座' ? '' : 'selected' %>>普通</option><option <%= form.bank_type === '当座' ? 'selected' : '' %>>当座</option></select></label>
    <label>口座番号（7桁） <input name="bank_number" value="<%= form.bank_number || '' %>" placeholder="1234567" inputmode="numeric"></label>
  </div>
  <label>口座名義（カナ） <input name="bank_holder" value="<%= form.bank_holder || '' %>" placeholder="ヤマダ タロウ"></label>

  <h2>4. 掲載方法</h2>
  <label class="menu"><input type="radio" name="publish" value="common" <%= form.publish !== 'original' ? 'checked' : '' %>>
    <span><strong>共通掲載</strong><br><span class="small">おくりギフトの公式LINEの「ギフトを贈る」に、お店が並びます</span></span></label>
  <label class="menu"><input type="radio" name="publish" value="original" <%= form.publish === 'original' ? 'checked' : '' %>>
    <span><strong>オリジナル</strong><br><span class="small">お店の公式LINEを自分で用意し、そのリッチメニューから贈れるようにします（運営が設定をお手伝いします）</span></span></label>

  <button class="btn wide">送信</button>
</form>
<%- include('_foot') %>
