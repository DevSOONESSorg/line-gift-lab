<%- include('_head') %>
<p><a href="/liff/platform/manage?mock_uid=<%= uid %>">← 店舗管理</a></p>
<h1><%= store.name %> の贈り物一覧</h1>
<p><a class="btn small secondary" href="/liff/platform/manage/<%= store.id %>/products?mock_uid=<%= uid %>">商品登録</a></p>
<% if (!orders.length) { %><p>まだ贈り物はありません。</p><% } %>
<% orders.forEach(function (o) { %>
  <div class="store-card">
    <div><strong>#<%= o.id %> <%= o.menu_name %></strong> <%= yen(o.amount) %>
      <% if (o.status === 'received') { %><span class="tag info">受取済み</span><% } else { %><span class="tag warn">リクエスト中</span><% } %></div>
    <div class="small"><%= o.route === 'common' ? '共通掲載から' : '公式LINEから' %> ／ 送り主：<%= o.buyer_name %> ／ 宛先：<%= o.recipient %><%= o.message ? ' ／「' + o.message + '」' : '' %></div>
    <% if (o.status === 'requested') { %>
      <form method="post" action="/liff/platform/manage/<%= store.id %>/orders/<%= o.id %>/receive">
        <input type="hidden" name="mock_uid" value="<%= uid %>">
        <button class="btn">受け取る</button>
      </form>
    <% } else if (!o.thanks_sent) { %>
      <form method="post" action="/liff/platform/manage/<%= store.id %>/orders/<%= o.id %>/thanks">
        <input type="hidden" name="mock_uid" value="<%= uid %>">
        <input name="text" placeholder="ひとことメッセージ（任意）">
        <button class="btn secondary">お礼を送る</button>
      </form>
    <% } else { %>
      <div class="small">お礼を送りました</div>
    <% } %>
  </div>
<% }) %>
<%- include('_foot') %>
