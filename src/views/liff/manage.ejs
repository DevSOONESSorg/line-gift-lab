<%- include('_head') %>
<h1>店舗管理</h1>
<% if (!stores.length) { %><p>あなたがオーナーのお店はまだありません。「出店登録」から登録してください。</p><% } %>
<% stores.forEach(function (s) { %>
  <div class="store-card">
    <div><strong><%= s.name %></strong>
      <% if (!s.approved) { %><span class="tag warn">承認待ち</span><% } %>
      <span class="tag info"><%= s.listed ? '共通掲載' : 'オリジナル' %></span></div>
    <div class="small">商品：<%= s.menu_count %> 件 ／ 受け取り待ち：<%= s.waiting %> 件</div>
    <div class="links">
      <a class="btn small" href="/liff/platform/manage/<%= s.id %>?mock_uid=<%= uid %>">贈り物一覧</a>
      <a class="btn small secondary" href="/liff/platform/manage/<%= s.id %>/products?mock_uid=<%= uid %>">商品登録</a>
    </div>
  </div>
<% }) %>
<%- include('_foot') %>
