<%- include('_head') %>
<div class="store-head">
  <div class="store-name"><%= store.name %></div>
  <div class="who">ようこそ <span id="who"><%= user ? user.display_name + ' さん' : '（LINEで確認中…）' %></span></div>
</div>

<% if (isFriend === false && friendUrl) { %>
  <div class="notice">この店の公式LINEを友だち追加すると、購入のお知らせが届きます。
    <a class="btn small" href="<%= friendUrl %>" target="_top">友だち追加</a></div>
<% } else if (isFriend === null && friendUrl && !uid) { %>
  <p class="small"><a href="<%= friendUrl %>">公式LINEを友だち追加する</a></p>
<% } %>

<% if (error) { %><p class="err"><%= error %></p><% } %>

<% if (!menus.length) { %>
  <p class="err">このお店にはまだメニューがありません。</p>
<% } else { %>
<form method="post" action="/liff/s/<%= store.slug %>/order" enctype="multipart/form-data">
  <input type="hidden" name="mock_uid" value="<%= uid %>">
  <input type="hidden" name="buyer_uid" value="">
  <input type="hidden" name="buyer_name" value="">

  <h2>1. メニューを選ぶ</h2>
  <% menus.forEach(function (m) { %>
    <label class="menu"><input type="radio" name="menu_id" value="<%= m.id %>" <%= String(form.menu_id) === String(m.id) ? 'checked' : '' %>>
      <span><%= m.name %></span><strong>¥<%= m.price.toLocaleString() %></strong></label>
  <% }) %>

  <h2>2. 宛先・メッセージ</h2>
  <label>贈る相手のお名前 <input name="recipient" value="<%= form.recipient || '' %>" placeholder="例：山田さん"></label>
  <label>メッセージ <textarea name="message" rows="2"><%= form.message || '' %></textarea></label>
  <% if (store.id_required) { %>
    <label>身分証の画像（このお店は必須） <input type="file" name="id_image" accept="image/*"></label>
  <% } %>

  <h2>3. お支払い（テスト）</h2>
  <label>カード番号 <input name="card_number" value="<%= form.card_number || '' %>" placeholder="4242 4242 4242 4242" inputmode="numeric"></label>
  <div class="row">
    <label>有効期限 <input name="exp" value="<%= form.exp || '' %>" placeholder="12/40"></label>
    <label>CVC <input name="cvc" value="<%= form.cvc || '' %>" placeholder="123" inputmode="numeric"></label>
  </div>
  <button class="btn wide">購入する</button>
  <p class="small">体験用のテスト決済です。本物のお金は動きません。</p>
</form>
<% } %>

<% if (!uid && liffId) { %>
<!-- 本物のLINEで開かれたとき：LIFF SDK で「誰が開いたか」を取り出す -->
<script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
<script>
  liff.init({ liffId: '<%= liffId %>' })
    .then(async () => {
      if (!liff.isLoggedIn()) return liff.login();
      const profile = await liff.getProfile();
      document.querySelector('[name=buyer_uid]').value = profile.userId;
      document.querySelector('[name=buyer_name]').value = profile.displayName;
      document.getElementById('who').textContent = profile.displayName + ' さん';
    })
    .catch((e) => { document.getElementById('who').textContent = '（LIFFの準備に失敗：' + e.message + '）'; });
</script>
<% } %>
<%- include('_foot') %>
