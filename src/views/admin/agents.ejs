<%- include('../partials/admin-start') %>
<h1>代理店管理 <a class="button small" href="/admin/agents?new=1">新規登録</a></h1>
<% if (creating) { %>
<section class="card">
  <h2>代理店を登録</h2>
  <form method="post" action="/admin/agents" class="inline-form">
    <label>代理店名 <input name="name" required></label>
    <label>親代理店
      <select name="parent_id">
        <option value="">なし（＝1次代理店）</option>
        <% parents.forEach(function (p) { %><option value="<%= p.id %>"><%= p.name %>（<%= p.code %>）</option><% }) %>
      </select>
    </label>
    <label>報酬率（%） <input name="rate" type="number" step="0.1" min="0" value="20"></label>
    <button>登録する</button>
  </form>
  <p class="hint">親代理店を選ぶと2次代理店になり、報酬率は 0% になります（取り分は1次から受け取るため）。紹介コード（6桁）は自動で発行されます。</p>
</section>
<% } %>
<table class="table">
  <thead><tr><th>代理店名</th><th>区分</th><th>紹介コード</th><th>報酬率</th><th>店舗数</th></tr></thead>
  <tbody>
  <% agents.forEach(function (a) { %>
    <tr><td><%= a.parent_id ? '　└ ' : '' %><%= a.name %></td><td><%= a.parent_id ? '2次（親：' + a.parent_name + '）' : '1次' %></td>
      <td><code><%= a.code %></code></td><td><%= a.rate %>%</td><td><%= a.store_count %></td></tr>
  <% }) %>
  </tbody>
</table>
<%- include('../partials/admin-end') %>
