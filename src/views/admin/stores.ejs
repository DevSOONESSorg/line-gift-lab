<%- include('../partials/admin-start') %>
<h1>店舗管理</h1>
<table class="table">
  <thead><tr><th>ID</th><th>店名</th><th>スラッグ</th><th>ステータス</th><th>メニュー</th><th>代理店</th><th>LINE連携</th><th></th></tr></thead>
  <tbody>
  <% stores.forEach(function (s) { %>
    <tr>
      <td><%= s.id %></td>
      <td><a href="/admin/stores/<%= s.id %>"><%= s.name %></a></td>
      <td><code><%= s.slug %></code></td>
      <td><% if (s.approved) { %><span class="badge ok">承認済み</span><% } else { %><span class="badge warn">未承認</span><% } %></td>
      <td><%= s.menu_count %></td>
      <td><%= s.agent_name || '—' %></td>
      <td><%= [s.liff_id, s.channel_id, s.channel_secret, s.access_token, s.basic_id].filter(Boolean).length %> / 5</td>
      <td><a class="button small" href="/admin/stores/<%= s.id %>/edit">編集</a></td>
    </tr>
  <% }) %>
  <% if (!stores.length) { %><tr><td colspan="8" class="empty">店舗はまだありません。左下のQRから出店登録してみましょう。</td></tr><% } %>
  </tbody>
</table>

<details class="card">
  <summary>＋ 管理画面から店舗を追加する（コースB用）</summary>
  <p class="muted">本来は、お店の人が「おくりギフト(dev)」の出店登録から申し込みます。コースBで本物のLINEとつなぐときは、ここから直接作ってかまいません（承認済みで作られます）。</p>
  <form method="post" action="/admin/stores" class="inline-form">
    <label>店名 <input name="name" required></label>
    <label>スラッグ <input name="slug" placeholder="my-shop" pattern="[a-z0-9][a-z0-9-]+" required></label>
    <button>作成</button>
  </form>
</details>
<%- include('../partials/admin-end') %>
