<%- include('../partials/admin-start') %>
<p><a href="/admin/stores/<%= store.id %>">← 店舗詳細</a></p>
<h1><%= store.name %> を編集</h1>
<% if (error) { %><p class="error-box"><%= error %></p><% } %>

<form method="post" action="/admin/stores/<%= store.id %>/edit" class="edit-form">
  <div class="grid2">
    <section class="card">
      <h2>基本情報</h2>
      <label>店名 <input name="name" value="<%= store.name %>" required></label>
      <label>スラッグ <input name="slug" value="<%= store.slug %>" required></label>
      <p class="hint">URLに入る「お店の住所」です。一度決めたら変えないでください。LIFFのエンドポイントURLとWebhook URLにも入っています。</p>
    </section>
    <section class="card">
      <h2>管理設定</h2>
      <label class="check"><input type="checkbox" name="approved" value="1" <%= store.approved ? 'checked' : '' %>> 承認済み</label>
      <label>デフォルト手数料率（%） <input name="fee_rate" type="number" step="0.1" min="0" value="<%= store.fee_rate %>"></label>
      <label class="check"><input type="checkbox" name="listed" value="1" <%= store.listed ? 'checked' : '' %>> 共通掲載（運営LINEの「ギフトを贈る」に並べる）</label>
      <% if (store.wants_original) { %><p class="hint">このお店は出店登録で「オリジナル（自前の公式LINE）」を希望しています。</p><% } %>
      <label class="check"><input type="checkbox" name="id_required" value="1" <%= store.id_required ? 'checked' : '' %>> 身分証提示を必須</label>
      <label>紐付け代理店
        <select name="agent_id">
          <option value="">なし</option>
          <% agents.forEach(function (a) { %>
            <option value="<%= a.id %>" <%= Number(store.agent_id) === a.id ? 'selected' : '' %>><%= a.parent_id ? '　└ ' : '' %><%= a.name %>（<%= a.code %>）</option>
          <% }) %>
        </select>
      </label>
    </section>
  </div>

  <section class="card">
    <h2>オーナー・口座（出店登録でオーナーが入力）</h2>
    <dl class="dl">
      <dt>オーナー</dt><dd><%= store.owner_name || '—' %> <%= store.owner_phone || '' %></dd>
      <dt>振込口座</dt><dd><%= store.bank_name ? store.bank_name + ' ' + store.bank_branch + ' ' + store.bank_type + ' ****' + String(store.bank_number).slice(-3) + ' ' + store.bank_holder : '—（未登録）' %></dd>
    </dl>
    <p class="hint">承認するときに、口座が登録されているかを確認します。口座番号は画面では下3桁だけ表示します。</p>
  </section>

  <section class="card" id="line">
    <h2>LINE 連携設定（店舗専用チャネル）</h2>
    <p class="hint">オリジナル（お店の公式LINE）で贈れるようにするお店だけ設定します。共通掲載だけのお店は空のままでOKです。</p>
    <div class="grid2">
      <label>LIFF ID <input name="liff_id" value="<%= store.liff_id %>" placeholder="2009896760-NLWo39Yw"></label>
      <label>Messaging API チャネルID <input name="channel_id" value="<%= store.channel_id %>" placeholder="10桁の数字"></label>
      <label>チャネルシークレット
        <input name="channel_secret" type="password" autocomplete="off" placeholder="<%= store.channel_secret ? '設定済み（変えるときだけ入力）' : '32文字' %>"></label>
      <label>アクセストークン（長期）
        <input name="access_token" type="password" autocomplete="off" placeholder="<%= store.access_token ? '設定済み（変えるときだけ入力）' : '発行したトークン' %>"></label>
      <label>LINE公式アカウントID（@xxx） <input name="basic_id" value="<%= store.basic_id %>" placeholder="@123abcde"></label>
    </div>
    <p class="hint">シークレットとトークンは保存後「設定済み」表示になり、入力欄は空になります。空欄のまま保存しても値は消えません。</p>
  </section>

  <p><button class="big">更新</button></p>
</form>

<section class="card">
  <h2>LINE 連携 確認 / テスト</h2>
  <p><strong>Webhook URL</strong>（Developers の Messaging API タブに貼る）</p>
  <div class="copy-row"><code id="wh"><%= webhookLocal %></code><button type="button" onclick="copyText('wh', this)">コピー</button></div>
  <% if (webhookPublic) { %>
    <p><strong>公開用 Webhook URL</strong>（コースB：本物のLINEはこちら）</p>
    <div class="copy-row"><code id="whp"><%= webhookPublic %></code><button type="button" onclick="copyText('whp', this)">コピー</button></div>
  <% } %>
  <p><strong>LIFF のエンドポイントURL</strong>（Developers の LIFF タブに入れる）</p>
  <div class="copy-row"><code id="ep"><%= liffEndpointLocal %></code><button type="button" onclick="copyText('ep', this)">コピー</button></div>
  <% if (liffEndpointPublic) { %>
    <div class="copy-row"><code id="epp"><%= liffEndpointPublic %></code><button type="button" onclick="copyText('epp', this)">コピー</button></div>
  <% } %>

  <div class="inline-form">
    <form method="post" action="/admin/stores/<%= store.id %>/check"><button>設定整合性をチェック</button></form>
    <form method="post" action="/admin/stores/<%= store.id %>/test-send"><button class="secondary">店舗管理者にテスト送信</button></form>
  </div>

  <% if (checks) { %>
    <h3>設定整合性 <% if (allOk) { %><span class="badge ok">すべてOK</span><% } else { %><span class="badge ng">NGあり</span><% } %></h3>
    <ul class="checks">
      <% checks.forEach(function (c) { %>
        <li class="<%= c.ok ? 'ok' : 'ng' %>"><strong><%= c.ok ? 'OK' : 'NG' %></strong> <%= c.label %><% if (!c.ok || c.hint.startsWith('このトークン')) { %><div class="hint"><%= c.hint %></div><% } %></li>
      <% }) %>
    </ul>
  <% } %>
  <% if (testResult) { %>
    <p class="<%= testResult.ok ? 'ok-box' : 'error-box' %>">テスト送信：<%= testResult.message %></p>
  <% } %>
</section>
<script>
function copyText(id, btn) {
  const t = document.getElementById(id).textContent;
  (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(
    () => { btn.textContent = 'コピーしました'; setTimeout(() => (btn.textContent = 'コピー'), 1500); },
    () => { prompt('コピーしてください', t); });
}
</script>
<%- include('../partials/admin-end') %>
