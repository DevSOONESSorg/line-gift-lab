<%- include('_start') %>
<h1><%= provider.name %></h1>
<h2>チャネル <a class="button small" href="?create=login">新規チャネル作成</a></h2>
<% if (creating) { %>
<section class="card">
  <h3>新規チャネル作成</h3>
  <form method="post" action="/mock/developers/provider/<%= provider.id %>/channels" class="form">
    <p>チャネルの種類</p>
    <label class="check"><input type="radio" name="type" value="login" checked> LINEログイン</label>
    <label class="check"><input type="radio" name="type" value="messaging"> Messaging API</label>
    <label>チャネル名 <input name="name" placeholder="店舗名 LIFF"></label>
    <label>チャネル説明 <input name="description"></label>
    <p>アプリタイプ</p>
    <label class="check"><input type="checkbox" name="app_type" value="web"> ウェブアプリ</label>
    <button>作成</button>
  </form>
</section>
<% } %>
<div class="cards">
  <% channels.forEach(function (c) { %>
    <% if (c.hasRole) { %>
      <a class="ch-card" href="/mock/developers/channel/<%= c.id %>"><span class="tag <%= c.type %>"><%= TYPE_LABELS[c.type] %></span><strong><%= c.name %></strong><small><%= c.channel_id %></small></a>
    <% } else { %>
      <div class="ch-card disabled" title="このチャネルの権限がありません"><span class="tag"><%= TYPE_LABELS[c.type] %></span><strong><%= c.name %></strong><small>権限なし</small></div>
    <% } %>
  <% }) %>
</div>
<p class="hint">グレーのチャネルは「権限なし」です。自分が作っていないチャネルはこうなります（不具合ではありません）。</p>
<%- include('_end') %>
