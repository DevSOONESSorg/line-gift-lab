<%- include('_start') %>
<h1><span class="tag <%= channel.type %>"><%= TYPE_LABELS[channel.type] %></span> <%= channel.name %></h1>
<nav class="tabs">
  <a class="<%= tab === 'basic' ? 'on' : '' %>" href="?tab=basic">Basic settings</a>
  <% if (channel.type === 'messaging') { %><a class="<%= tab === 'messaging' ? 'on' : '' %>" href="?tab=messaging">Messaging API</a><% } %>
  <% if (channel.type === 'login') { %><a class="<%= tab === 'liff' ? 'on' : '' %>" href="?tab=liff">LIFF</a><% } %>
  <a class="<%= tab === 'roles' ? 'on' : '' %>" href="?tab=roles">権限設定（Roles）</a>
</nav>

<% if (tab === 'basic') { %>
  <section class="card">
    <dl class="dl">
      <dt>Channel ID</dt><dd><code class="big-code"><%= channel.channel_id %></code></dd>
      <dt>Channel secret</dt><dd>
        <code class="big-code" id="sec"><%= channel.secret %></code>
          <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('sec').textContent); this.textContent='コピーしました'">コピー</button>
        <form method="post" action="/mock/developers/channel/<%= channel.id %>/secret" onsubmit="return confirm('再発行すると、今のシークレットは使えなくなります。よろしいですか？')" class="inline"><button class="small secondary">再発行</button></form>
      </dd>
      <dt>プロバイダー</dt><dd><%= provider.name %></dd>
      <% if (oa) { %><dt>LINE公式アカウント</dt><dd><%= oa.name %>（<%= oa.basic_id %>）</dd><% } %>
      <dt>作成者</dt><dd><%= channel.created_by === 'company' ? '会社の作業アカウント' : 'あなたの個人アカウント' %></dd>
      <% if (channel.type === 'login') { %><dt>アプリタイプ</dt><dd>ウェブアプリ</dd><% } %>
    </dl>
  </section>
<% } %>

<% if (tab === 'messaging' && channel.type === 'messaging') { %>
  <section class="card">
    <h2>Webhook settings</h2>
    <form method="post" action="/mock/developers/channel/<%= channel.id %>/webhook" class="inline-form">
      <label class="grow">Webhook URL <input name="webhook_url" value="<%= channel.webhook_url %>" placeholder="http://localhost:3000/api/webhook/line/store/{slug}"></label>
      <button>Update</button>
    </form>
    <div class="inline-form">
      <form method="post" action="/mock/developers/channel/<%= channel.id %>/webhook/verify"><button class="secondary">Verify</button></form>
      <form method="post" action="/mock/developers/channel/<%= channel.id %>/webhook/use">
        <input type="hidden" name="use_webhook" value="<%= channel.use_webhook ? '0' : '1' %>">
        <label class="switch">Use webhook <button class="toggle <%= channel.use_webhook ? 'on' : '' %>"><%= channel.use_webhook ? 'ON' : 'OFF' %></button></label>
      </form>
    </div>
    <% if (verify) { %>
      <% if (verify.ok) { %><p class="ok-box">Success（<%= verify.status %>）…自社サーバーが「受け取りました」と答えました</p>
      <% } else { %><p class="error-box">Error（<%= verify.status || '接続できません' %>）<%= verify.message %><br><small>URL の slug・ポート・環境が合っているか、自社サーバーが動いているかを確認しましょう。詳しくは裏側ビューへ。</small></p><% } %>
    <% } %>
  </section>
  <section class="card">
    <h2>チャネルアクセストークン（長期）</h2>
    <% if (channel.access_token) { %>
      <code class="big-code wrap" id="tok"><%= channel.access_token %></code>
      <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('tok').textContent); this.textContent='コピーしました'">コピー</button>
    <% } else { %><p class="muted">まだ発行されていません。</p><% } %>
    <form method="post" action="/mock/developers/channel/<%= channel.id %>/token" <%= channel.access_token ? 'onsubmit="return confirm(\'再発行すると、今のトークンは使えなくなります。よろしいですか？\')"' : '' %>>
      <button class="small"><%= channel.access_token ? '再発行' : '発行' %></button></form>
  </section>
<% } %>

<% if (tab === 'liff' && channel.type === 'login') { %>
  <section class="card">
    <h2>LIFFアプリ</h2>
    <table class="table">
      <thead><tr><th>LIFF ID</th><th>名前</th><th>サイズ</th><th>エンドポイントURL</th><th></th></tr></thead>
      <tbody>
        <% liffs.forEach(function (l) { %>
          <tr><td><code><%= l.liff_id %></code></td><td><%= l.name %></td><td><%= l.size %></td>
            <td><form method="post" action="/mock/developers/channel/<%= channel.id %>/liff/<%= l.liff_id %>/endpoint" class="inline-form"><input name="endpoint_url" value="<%= l.endpoint_url %>" size="40"><button class="small">更新</button></form></td>
            <td><form method="post" action="/mock/developers/channel/<%= channel.id %>/liff/<%= l.liff_id %>/delete"><button class="link danger small">削除</button></form></td></tr>
        <% }) %>
        <% if (!liffs.length) { %><tr><td colspan="5" class="empty">LIFFアプリはまだありません</td></tr><% } %>
      </tbody>
    </table>
  </section>
  <section class="card">
    <h2>追加</h2>
    <form method="post" action="/mock/developers/channel/<%= channel.id %>/liff" class="form">
      <label>LIFFアプリ名 <input name="name" value="<%= channel.name %>"></label>
      <p>サイズ</p>
      <label class="check"><input type="radio" name="size" value="Compact"> Compact</label>
      <label class="check"><input type="radio" name="size" value="Tall"> Tall</label>
      <label class="check"><input type="radio" name="size" value="Full" checked> Full</label>
      <label>エンドポイントURL <input name="endpoint_url" placeholder="http://localhost:3000/liff/s/{slug}"></label>
      <p>Scope</p>
      <label class="check"><input type="checkbox" name="scopes" value="profile" checked> profile</label>
      <label class="check"><input type="checkbox" name="scopes" value="openid" checked> openid</label>
      <button>追加</button>
    </form>
  </section>
<% } %>

<% if (tab === 'roles') { %>
  <section class="card">
    <h2>このチャネルの権限を持つ人</h2>
    <ul><% roles.forEach(function (r) { %><li><%= r.name %>（<%= r.email %>）— Admin</li><% }) %></ul>
    <form method="post" action="/mock/developers/channel/<%= channel.id %>/roles" class="inline-form">
      <select name="account_id"><% accounts.forEach(function (a) { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select>
      <button>Admin として追加</button>
    </form>
    <p class="hint">権限は2層です。プロバイダーのメンバー（箱に入れるか）と、チャネルごとの権限（そのチャネルを開けるか）。</p>
  </section>
<% } %>
<%- include('_end') %>
