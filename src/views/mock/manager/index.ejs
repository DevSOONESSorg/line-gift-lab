<%- include('_start') %>
<h1>アカウントリスト <a class="button small" href="/mock/manager/create">作成</a></h1>
<p class="lead">疑似 LINE Official Account Manager です。ログイン中のアカウントがメンバーになっている公式アカウントだけが表示されます。</p>
<div class="cards">
  <% oas.forEach(function (o) { %>
    <a class="oa-card" href="/mock/manager/oa/<%= o.id %>">
      <span class="oa-icon"><%= o.name.slice(0, 1) %></span>
      <span><strong><%= o.name %></strong><br><small><%= o.basic_id %> ・ <%= ROLE_LABELS[o.role] %></small></span>
    </a>
  <% }) %>
</div>
<% if (!oas.length) { %><p class="empty">まだありません。左上の「作成」から公式アカウントを作りましょう。</p><% } %>
<%- include('_end') %>
