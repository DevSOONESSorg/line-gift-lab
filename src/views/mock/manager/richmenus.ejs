<%- include('_start') %>
<h1>リッチメニュー <a class="button small" href="/mock/manager/oa/<%= oa.id %>/richmenus/new">作成</a></h1>
<% menus.forEach(function (m) { const acts = JSON.parse(m.actions); %>
  <section class="card rm-row">
    <div class="rm-preview"><img src="/mock/uploads/richmenu/<%= m.image_path %>" alt=""></div>
    <div>
      <h3><%= m.title %> <% if (m.is_default) { %><span class="badge ok">表示中</span><% } %></h3>
      <p class="muted"><%= templates[m.template] ? templates[m.template].label : m.template %> ／ <%= m.width %>×<%= m.height %>px</p>
      <ul class="small">
        <% acts.forEach(function (a, i) { %><li><%= String.fromCharCode(65 + i) %>：<%= a.type === 'link' ? 'リンク ' + a.value : a.type === 'text' ? 'テキスト「' + a.value + '」' : '設定なし' %></li><% }) %>
      </ul>
      <div class="inline-form">
        <% if (!m.is_default) { %><form method="post" action="/mock/manager/oa/<%= oa.id %>/richmenus/<%= m.id %>/default"><button class="small">これを表示する</button></form><% } %>
        <form method="post" action="/mock/manager/oa/<%= oa.id %>/richmenus/<%= m.id %>/delete"><button class="small secondary">削除</button></form>
      </div>
    </div>
  </section>
<% }) %>
<% if (!menus.length) { %><p class="empty">リッチメニューはまだありません。</p><% } %>
<%- include('_end') %>
