# このファイルを .env という名前でコピーして使います
# APP_NAME: 画面の左上に出るサービス名（体験用の名前に変えてもOK）
# PORT:     ブラウザで開くポート番号
APP_NAME=おくりギフト
PORT=3000

# ---- ここから下はコースB（本物のLINE）で使います ----
# 公開URL（cloudflared を使うときは自動で取得するので空のままでOK）
PUBLIC_URL=
# リッチメニューをAPIで作るときに使う「長期チャネルアクセストークン」
LINE_CHANNEL_ACCESS_TOKEN=
# リッチメニューのJSONの {LIFF_ID} に入る値（--store を使うときは不要）
LINE_LIFF_ID=
