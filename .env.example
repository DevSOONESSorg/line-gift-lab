# このファイルを .env という名前でコピーして使います（docker compose up で自動でコピーされます）
APP_NAME=おくりギフト
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_TIMEZONE=Asia/Tokyo

# 画面の右下に出す環境名（dev / stg / prod）。本物の管理画面の「PROD」表示と同じ役割
APP_STAGE=dev

# ブラウザで開くポート（docker-compose.yml が使う）
PORT=3000

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- コースB（本物のLINE）で使います ----
# 公開URL（cloudflared を使うときは自動で取得するので空のままでOK）
PUBLIC_URL=
TUNNEL_METRICS=http://tunnel:2000
